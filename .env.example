# =========================
# Django / Server
# =========================
DEBUG=True
SECRET_KEY=your-django-secret-key
DATABASE_URL=postgres://user:password@localhost:5432/dbname
FRONTEND_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# =========================
# AWS S3 Storage
# =========================
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_REGION_NAME=ap-northeast-2
AWS_STORAGE_BUCKET_NAME=your-s3-bucket-name


# =========================
# Google OAuth
# =========================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/accounts/google/login/callback/


# =========================
# Kakao OAuth
# =========================
KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_CLIENT_SECRET=your-kakao-client-secret
KAKAO_REDIRECT_URI=http://localhost:8000/accounts/kakao/login/callback/


# =========================
# Naver Map API
# =========================
NAVER_MAP_CLIENT_ID=your-naver-map-client-id
NAVER_MAP_CLIENT_SECRET=your-naver-map-client-secret


# =========================
# AI / External APIs
# =========================
GEMINI_API_KEY=your-gemini-api-key
POLICE_API_KEY=your-police-api-key